# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# --- Proxmox connection ---

proxmox_endpoint = "https://192.168.1.10:8006/"
proxmox_node     = "pve"

# The Proxmox host's root@pam login password (the Proxmox web-UI root login).
# REQUIRED: setting LXC feature flags (keyctl, which Docker-in-LXC needs) is
# restricted to root@pam and cannot be done with an API token. The paired
# username defaults to "root@pam" (var.proxmox_username).
# Can alternatively be supplied via the TF_VAR_proxmox_password env var.
proxmox_password = "change-me"

# The Ubuntu template is downloaded by Terraform (see template_url /
# template_datastore_id defaults in variables.tf); override only if needed.

# --- Container placement / sizing ---
datastore_id         = "local-lvm"
storage_datastore_id = "local-lvm"
data_size_gb         = 8

# --- Networking (static so the Ansible inventory points at a known address) ---
container_ip_cidr = "192.168.1.60/24"
container_gateway = "192.168.1.1"
dns_servers       = ["192.168.1.1"]

# --- Access ---

# SSH public key injected into the container's root account; Ansible connects
# with the matching private key.
ssh_public_key_path = "~/.ssh/deploy/me-tracker.pub"

# Password for the container's OWN root account (console/fallback login).
container_root_password = "change-me"
