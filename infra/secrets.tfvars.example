# Template for m900-secrets.tfvars. Copy it (the copy is gitignored) and fill in.
# Keep the real value in your password manager, not here.
#
# The Proxmox root@pam password does NOT go here. It's exported as
# TF_VAR_proxmox_password in ~/.config/homelab/secrets.env, and the wrappers load it.

# The container's OWN root account password (console/fallback login).
container_root_password = "change-me"
